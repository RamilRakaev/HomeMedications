@page "/"
@rendermode InteractiveServer

<div class="med-page">
<PageTitle>Приём лекарств</PageTitle>

<h1>Приём лекарств</h1>
<p class="lead">Новая запись: если название уже было в таблице, поля заполнятся по последней записи; дата начала — сегодня.</p>

<div class="card med-card">
    <h2>Новая запись</h2>
    <EditForm Model="_draft" OnValidSubmit="AddAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="med-validation-summary" />

        <div class="form-grid med-form-grid">
            <div class="field span-6">
                <label class="med-label" for="name">Лекарство</label>
                <div class="chic-input chic-input--medicine">
                    <span class="chic-input__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 11h8M10 8v10M14 8v10M9 5h6a2 2 0 012 2v11a2 2 0 01-2 2H9a2 2 0 01-2-2V7a2 2 0 012-2z"/></svg>
                    </span>
                    <InputText id="name" class="chic-input__control" @bind-Value="_draft.MedicineName" @bind-Value:after="OnMedicineNameChanged" placeholder="Название" />
                    @if (!string.IsNullOrWhiteSpace(_draft.MedicineName))
                    {
                        <button type="button" class="chic-input__clear" @onclick="ClearMedicineName" aria-label="Очистить поле">×</button>
                    }
                </div>
            </div>
            <div class="field span-6">
                <label class="med-label" for="dosage">Дозировка</label>
                <div class="chic-input chic-input--dosage">
                    <InputText id="dosage" class="chic-input__control" @bind-Value="_draft.Dosage" placeholder="Например, 30 мг" />
                    <span class="chic-input__trail" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3z"/></svg>
                    </span>
                </div>
            </div>
            <div class="field">
                <label class="med-label" for="qty">Количество, шт.</label>
                <div class="chic-input chic-input--qty">
                    <span class="chic-input__icon" aria-hidden="true">#</span>
                    <InputNumber id="qty" class="chic-input__control" @bind-Value="_draft.QuantityUnits" />
                </div>
            </div>
            <div class="field">
                <label class="med-label" for="intakes">Приёмов за период</label>
                <div class="chic-input chic-input--intakes">
                    <span class="chic-input__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 3v4M16 3v4M4 11h16"/></svg>
                    </span>
                    <InputNumber id="intakes" class="chic-input__control" @bind-Value="_draft.IntakesPerPeriod" />
                </div>
            </div>
            <div class="field">
                <label class="med-label" for="period">Период для «приёмов»</label>
                <div class="chic-input chic-input--select">
                    <InputSelect id="period" class="chic-input__control" @bind-Value="_draft.IntakePeriod">
                        <option value="@IntakePeriodKind.PerDay">В день</option>
                        <option value="@IntakePeriodKind.PerWeek">В неделю</option>
                    </InputSelect>
                </div>
            </div>
            <div class="field">
                <label class="med-label" for="freq">Частота</label>
                <div class="chic-input chic-input--select">
                    <InputSelect id="freq" class="chic-input__control" @bind-Value="_draft.Frequency">
                        <option value="@MedicationFrequency.EveryDay">Каждый день</option>
                        <option value="@MedicationFrequency.SeveralTimesPerWeek">Несколько раз в неделю</option>
                    </InputSelect>
                </div>
            </div>
            <div class="field">
                <label class="med-label" for="start">Дата начала</label>
                <div class="chic-input chic-input--date">
                    <span class="chic-input__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 11h16"/></svg>
                    </span>
                    <InputDate id="start" class="chic-input__control" @bind-Value="_draft.StartDate" />
                </div>
            </div>
            <div class="field">
                <label class="med-label" for="end">Дата завершения</label>
                <div class="chic-input chic-input--date">
                    <span class="chic-input__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 11h16"/></svg>
                    </span>
                    <InputDate id="end" class="chic-input__control" @bind-Value="_draft.EndDate" />
                </div>
            </div>
            <div class="field span-12 actions">
                <button class="btn btn-primary btn-pill btn-add-table" type="submit">
                    <span class="btn-glow" aria-hidden="true"></span>
                    <span class="btn-pill-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
                    </span>
                    <span class="btn-inner">Добавить в таблицу</span>
                </button>
            </div>
        </div>
    </EditForm>
    <p class="hint">Подсказка: введите точно такое же название, как в прошлой записи (без учёта регистра), чтобы подтянуть дозировку, количество, приёмы и частоту.</p>
</div>

<div class="card med-card">
    <h2>Записи</h2>
    @if (!string.IsNullOrEmpty(_editError))
    {
        <p class="edit-error" role="alert">@_editError</p>
    }
    @if (_rows.Count == 0)
    {
        <p class="muted">Пока нет записей.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Лекарство</th>
                        <th>Дозировка</th>
                        <th>Шт.</th>
                        <th>Приёмы</th>
                        <th>Частота</th>
                        <th>Начало</th>
                        <th>Завершение</th>
                        <th class="th-actions">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        @if (_editModel is not null && _editModel.Id == row.Id)
                        {
                            <tr class="row-editing">
                                <td><InputText class="table-input" @bind-Value="_editModel.MedicineName" @bind-Value:after="OnEditMedicineNameChanged" /></td>
                                <td><InputText class="table-input" @bind-Value="_editModel.Dosage" /></td>
                                <td><InputNumber class="table-input" @bind-Value="_editModel.QuantityUnits" /></td>
                                <td>
                                    <div class="edit-intakes">
                                        <InputNumber class="table-input" @bind-Value="_editModel.IntakesPerPeriod" />
                                        <InputSelect class="table-input" @bind-Value="_editModel.IntakePeriod">
                                            <option value="@IntakePeriodKind.PerDay">В день</option>
                                            <option value="@IntakePeriodKind.PerWeek">В неделю</option>
                                        </InputSelect>
                                    </div>
                                </td>
                                <td>
                                    <InputSelect class="table-input" @bind-Value="_editModel.Frequency">
                                        <option value="@MedicationFrequency.EveryDay">Каждый день</option>
                                        <option value="@MedicationFrequency.SeveralTimesPerWeek">Несколько раз в неделю</option>
                                    </InputSelect>
                                </td>
                                <td><InputDate class="table-input" @bind-Value="_editModel.StartDate" /></td>
                                <td><InputDate class="table-input" @bind-Value="_editModel.EndDate" /></td>
                                <td>
                                    <div class="cell-actions">
                                        <button type="button" class="btn btn-success btn-sm btn-pill" @onclick="SaveEditAsync">
                                            <span class="btn-inner">Сохранить</span>
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm btn-pill" @onclick="CancelEdit">
                                            <span class="btn-inner">Отмена</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="@(_editModel is not null ? "row-dimmed" : null)">
                                <td>@row.MedicineName</td>
                                <td>@row.Dosage</td>
                                <td>@row.QuantityUnits</td>
                                <td>@row.IntakesPerPeriod @PeriodSuffix(row.IntakePeriod)</td>
                                <td>@FrequencyLabel(row.Frequency)</td>
                                <td>@row.StartDate.ToString("dd.MM.yyyy")</td>
                                <td>@(row.EndDate is null ? "—" : row.EndDate.Value.ToString("dd.MM.yyyy"))</td>
                                <td>
                                    <div class="cell-actions">
                                        <button type="button" class="btn btn-secondary btn-sm btn-pill" disabled="@(_editModel is not null)" @onclick="() => BeginEdit(row)">
                                            <span class="btn-inner">Изменить</span>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm btn-pill" disabled="@(_editModel is not null)" @onclick="() => DeleteAsync(row.Id)">
                                            <span class="btn-inner">Удалить</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

</div>

@code {
    [Inject]
    private MedicationStore Store { get; set; } = default!;

    private MedicationEntry _draft = CreateEmptyDraft();
    private List<MedicationEntry> _rows = [];
    private MedicationEntry? _editModel;
    private string? _editError;

    protected override void OnInitialized()
    {
        RefreshRows();
    }

    private void RefreshRows()
    {
        _rows = Store.GetAll().ToList();
    }

    private void ClearMedicineName()
    {
        _draft.MedicineName = string.Empty;
    }

    private void OnMedicineNameChanged()
    {
        var prev = Store.GetLatestByName(_draft.MedicineName);
        if (prev is null)
            return;

        _draft.Dosage = prev.Dosage;
        _draft.QuantityUnits = prev.QuantityUnits;
        _draft.IntakesPerPeriod = prev.IntakesPerPeriod;
        _draft.IntakePeriod = prev.IntakePeriod;
        _draft.Frequency = prev.Frequency;
        _draft.StartDate = DateOnly.FromDateTime(DateTime.Today);
        _draft.EndDate = null;
    }

    private void OnEditMedicineNameChanged()
    {
        if (_editModel is null)
            return;

        var prev = Store.GetLatestByName(_editModel.MedicineName, _editModel.Id);
        if (prev is null)
            return;

        _editModel.Dosage = prev.Dosage;
        _editModel.QuantityUnits = prev.QuantityUnits;
        _editModel.IntakesPerPeriod = prev.IntakesPerPeriod;
        _editModel.IntakePeriod = prev.IntakePeriod;
        _editModel.Frequency = prev.Frequency;
    }

    private void BeginEdit(MedicationEntry row)
    {
        _editError = null;
        _editModel = CloneEntry(row);
    }

    private void CancelEdit()
    {
        _editModel = null;
        _editError = null;
    }

    private Task SaveEditAsync()
    {
        if (_editModel is null)
            return Task.CompletedTask;

        _editModel.MedicineName = _editModel.MedicineName.Trim();
        if (string.IsNullOrWhiteSpace(_editModel.MedicineName))
        {
            _editError = "Укажите название лекарства.";
            return Task.CompletedTask;
        }

        if (_editModel.IntakesPerPeriod < 1)
        {
            _editError = "Число приёмов должно быть не меньше 1.";
            return Task.CompletedTask;
        }

        if (_editModel.QuantityUnits < 0)
        {
            _editError = "Количество не может быть отрицательным.";
            return Task.CompletedTask;
        }

        _editModel.Dosage = _editModel.Dosage.Trim();
        _editModel.IntakesPerPeriod = Math.Max(1, _editModel.IntakesPerPeriod);
        _editModel.QuantityUnits = Math.Max(0, _editModel.QuantityUnits);

        Store.Update(_editModel);
        _editModel = null;
        _editError = null;
        RefreshRows();
        return Task.CompletedTask;
    }

    private Task AddAsync()
    {
        _draft.MedicineName = _draft.MedicineName.Trim();
        if (string.IsNullOrWhiteSpace(_draft.MedicineName))
            return Task.CompletedTask;

        var entry = new MedicationEntry
        {
            MedicineName = _draft.MedicineName,
            Dosage = _draft.Dosage.Trim(),
            QuantityUnits = Math.Max(0, _draft.QuantityUnits),
            IntakesPerPeriod = Math.Max(1, _draft.IntakesPerPeriod),
            IntakePeriod = _draft.IntakePeriod,
            Frequency = _draft.Frequency,
            StartDate = _draft.StartDate,
            EndDate = _draft.EndDate
        };

        Store.Add(entry);
        _draft = CreateEmptyDraft();
        RefreshRows();
        return Task.CompletedTask;
    }

    private Task DeleteAsync(Guid id)
    {
        if (_editModel?.Id == id)
            CancelEdit();

        Store.Delete(id);
        RefreshRows();
        return Task.CompletedTask;
    }

    private static MedicationEntry CloneEntry(MedicationEntry s) => new()
    {
        Id = s.Id,
        MedicineName = s.MedicineName,
        Dosage = s.Dosage,
        QuantityUnits = s.QuantityUnits,
        IntakesPerPeriod = s.IntakesPerPeriod,
        IntakePeriod = s.IntakePeriod,
        Frequency = s.Frequency,
        StartDate = s.StartDate,
        EndDate = s.EndDate
    };

    private static MedicationEntry CreateEmptyDraft()
    {
        return new MedicationEntry
        {
            MedicineName = "",
            Dosage = "",
            QuantityUnits = 0,
            IntakesPerPeriod = 1,
            IntakePeriod = IntakePeriodKind.PerDay,
            Frequency = MedicationFrequency.EveryDay,
            StartDate = DateOnly.FromDateTime(DateTime.Today),
            EndDate = null
        };
    }

    private static string PeriodSuffix(IntakePeriodKind kind) =>
        kind == IntakePeriodKind.PerWeek ? "за неделю" : "в день";

    private static string FrequencyLabel(MedicationFrequency f) =>
        f == MedicationFrequency.EveryDay ? "Каждый день" : "Несколько раз в неделю";
}
